# Copy to .env for a run against real providers. Never commit .env.

# Gateway
LITELLM_MASTER_KEY=sk-change-me
DATABASE_URL=                       # LiteLLM key and spend database (optional)
DERVA_AUDIT_URL=postgresql+psycopg://derva_app:PASSWORD@localhost/derva
DERVA_MASKER=presidio
DERVA_SPACY_MODEL=en_core_web_lg

# Tier models behind the "derva" alias (LiteLLM model strings)
DERVA_SMALL_UPSTREAM=anthropic/claude-haiku-5-5
DERVA_FRONTIER_UPSTREAM=anthropic/claude-sonnet-5-5

# Decision chain: decision model -> optional small LLM -> rules
DERVA_DECIDER_MODEL=typesafe/jev-latest   # pin a version for evaluation runs
TYPESAFE_API_KEY=
DERVA_FALLBACK_LLM=                       # e.g. anthropic/claude-haiku-5-5

# Evaluations
DERVA_JEV_MODEL=typesafe/jev-latest
DERVA_CLEF_MODEL=cloudflare/clef-flash
CLOUDFLARE_API_KEY=
DERVA_EVAL_LLM=anthropic/claude-haiku-5-5
ANTHROPIC_API_KEY=

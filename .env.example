# Copy to .env for a run against real providers on your laptop:
#   uv run --env-file .env litellm --config config/litellm.yaml --port 4000
# Never commit .env.

# Gateway
LITELLM_MASTER_KEY=sk-change-me
# LiteLLM's own key and spend database. DERVA does not use it: leave this line
# commented out, because LiteLLM refuses to start with an empty DATABASE_URL.
# DATABASE_URL=postgresql://USER:PASSWORD@localhost/litellm
# Audit log. A local SQLite file needs no database server; for the insert-only
# Postgres setup use postgresql+psycopg://derva_app:PASSWORD@localhost/derva
DERVA_AUDIT_URL=sqlite:///derva_audit_local.db
DERVA_MASKER=presidio
# uv installs spaCy's small model; the Docker image brings the large one itself.
DERVA_SPACY_MODEL=en_core_web_sm
# Load the masker while the proxy starts, not on the first request.
DERVA_WARM_START=true
# Caller keys for local runs: the demo keys sk-derva-demo (team wealth-a) and
# sk-derva-demo-b (team wealth-b). Staging reads DERVA_CALLERS from a secret.
DERVA_CALLERS_FILE=config/callers.demo.json

# Tier models behind the "derva" alias (LiteLLM model strings)
DERVA_SMALL_UPSTREAM=anthropic/claude-haiku-5-5
DERVA_FRONTIER_UPSTREAM=anthropic/claude-sonnet-5-5

# Decision chain: decision model -> optional small LLM -> rules
# Jev 1.13.0 was adopted on 26 Oct 2026 (results/DECISIONS.md). A newer version
# replaces it only after passing the adoption gate.
DERVA_DECIDER_MODEL=typesafe/jev-1.13.0
TYPESAFE_API_KEY=
# Alternative route to Jev through OpenRouter: set DERVA_DECIDER_MODEL=openrouter/typesafe/<model>
OPENROUTER_API_KEY=
# Optional small LLM between the decision model and the rules, e.g.
# anthropic/claude-haiku-5-5 or gemini/gemini-3.5-flash-lite
DERVA_FALLBACK_LLM=

# Evaluations
# The Jev version under evaluation; set it to a new release to test that one.
DERVA_JEV_MODEL=typesafe/jev-1.13.0
DERVA_CLEF_MODEL=cloudflare/clef-flash
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# The general-LLM baseline. Gemini's Flash-Lite models have a free tier
# (15 requests a minute): use gemini/gemini-3.5-flash-lite with GEMINI_API_KEY
# and DERVA_EVAL_RPM=15. Claude Haiku 5.5 is the cheapest paid option.
DERVA_EVAL_LLM=anthropic/claude-haiku-5-5
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Requests a minute for evaluation runs; leave empty for no limit.
DERVA_EVAL_RPM=

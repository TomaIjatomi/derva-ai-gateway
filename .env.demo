# Settings for the offline demo (docker compose or `make demo`).
DERVA_DECIDER_MODEL=typesafe/mock-decider-0
DERVA_DECIDER_API_BASE=http://localhost:8100
DERVA_DECIDER_API_KEY=demo
DERVA_MASKER=regex
DERVA_AUDIT_URL=sqlite:///derva_audit_demo.db
# Demo caller keys and their teams.
DERVA_CALLERS_FILE=config/callers.demo.json
# The demo chat model, also served by the mock server.
DERVA_DEMO_LLM_BASE=http://localhost:8100/v1
# Boot check only (see config/litellm.demo.yaml); requests use the caller keys.
LITELLM_MASTER_KEY=sk-derva-demo-boot-67fd8187f652abbe449347db001a0b9d
